---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Despliegue Facilito — Deploy Frontend Apps on AWS">
  <!-- Navigation -->
  <nav class="w-full border-b border-gray-100 bg-white/90 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-brand-green">
        Despliegue Facilito
      </a>
      <div class="flex items-center gap-4">
        <a
          href="/dashboard/login"
          class="text-sm font-medium text-gray-600 hover:text-brand-green transition-colors"
        >
          Iniciar sesión
        </a>
        <a
          href="/dashboard/signup"
          class="inline-flex items-center rounded-lg bg-brand-green px-4 py-2 text-sm font-semibold text-white hover:bg-brand-green-dark transition-colors"
        >
          Crear cuenta
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-24 sm:py-36 bg-gradient-to-b from-green-50/60 to-white">
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center rounded-full border border-brand-green/20 bg-brand-green/5 px-4 py-1.5 mb-8">
          <span class="text-xs font-medium text-brand-green-dark">Powered by AWS</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900">
          Despliega tus apps frontend
          <span class="block text-brand-green mt-2">sin complicaciones</span>
        </h1>
        <p class="mt-6 max-w-2xl mx-auto text-lg sm:text-xl text-gray-500 leading-relaxed">
          Conecta tu repositorio de GitHub, haz push y deja que Despliegue Facilito se encargue del resto.
          Builds automatizados, CDN global e URLs de preview al instante.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/dashboard/signup"
            class="inline-flex items-center rounded-lg bg-brand-green px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-brand-green/20 hover:bg-brand-green-dark hover:shadow-brand-green/30 transition-all"
          >
            Empieza gratis
          </a>
          <a
            href="#features"
            class="inline-flex items-center rounded-lg border border-gray-200 px-8 py-4 text-lg font-medium text-gray-600 hover:border-brand-green hover:text-brand-green transition-all"
          >
            Ver cómo funciona
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 sm:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
            Todo lo que necesitas para shipear más rápido
          </h2>
          <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
            Enfócate en construir tu app. Nosotros nos encargamos de la infraestructura.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature 1 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Detección automática de framework</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Sube tu proyecto React, Angular, Vue o Astro y detectamos el framework automáticamente. Sin configuración manual.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Push-to-Deploy con GitHub</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Conecta tu cuenta de GitHub y cada push a main dispara un build y deploy automático. Tu sitio siempre actualizado.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">CDN global con CloudFront</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Cada deploy se sirve a través de AWS CloudFront con un subdominio único. Tiempos de carga rápidos en todo el mundo.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Build logs en tiempo real</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Observa tus builds en vivo via WebSocket. Depura problemas al instante sin esperar notificaciones.
            </p>
          </div>

          <!-- Feature 5 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Dominios personalizados</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Mapea tu propio dominio a cualquier proyecto con configuración DNS simple. Sirve tu app desde tu propia URL.
            </p>
          </div>

          <!-- Feature 6 -->
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-green/30 transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-green/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Cero configuración</h3>
            <p class="mt-2 text-gray-500 text-sm leading-relaxed">
              Sin YAML, sin Dockerfiles, sin consola de cloud. Solo conecta tu repo y despliega. Así de simple.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 sm:py-24 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-brand-green/20 bg-white p-12 text-center shadow-sm">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
            ¿Listo para simplificar tus deploys?
          </h2>
          <p class="mt-4 text-lg text-gray-500">
            Únete a los desarrolladores que shipean más rápido con Despliegue Facilito.
          </p>
          <div class="mt-8">
            <a
              href="/dashboard/signup"
              class="inline-flex items-center rounded-lg bg-brand-green px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-brand-green/20 hover:bg-brand-green-dark transition-all"
            >
              Comienza a desplegar ahora
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-gray-400 text-sm">
          Hecho con 💚 — Despliegue Facilito © {new Date().getFullYear()}
        </p>
        <div class="flex items-center gap-6">
          <a href="/dashboard/login" class="text-sm text-gray-400 hover:text-brand-green transition-colors">
            Iniciar sesión
          </a>
          <a href="/dashboard/signup" class="text-sm text-gray-400 hover:text-brand-green transition-colors">
            Crear cuenta
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>
